# Discord Webhook URL (fallback si pas de bot)
# Créer un webhook: Serveur Discord > Paramètres du salon > Intégrations > Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/XXXXX/XXXXX

# Discord Bot Token (pour les réactions 👍👎)
# Créer: https://discord.com/developers/applications > Bot > Token
DISCORD_BOT_TOKEN=

# ID du salon où poster les annonces
# Clic droit sur le salon > Copier l'identifiant du salon
DISCORD_CHANNEL_ID=
# ID du salon pour les annonces likées (👍)
DISCORD_LIKED_CHANNEL_ID=
